# ============================================================
# AtmosMetrics — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
# ============================================================

# ---- PostgreSQL --------------------------------------------
POSTGRES_DB=atmosmetrics
POSTGRES_USER=atmos_user
POSTGRES_PASSWORD=atmos_pass_seguro
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- pgAdmin (apenas em desenvolvimento) -------------------
PGADMIN_DEFAULT_EMAIL=admin@atmosmetrics.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_pass_seguro

# ---- Chaves de API (ETL) -----------------------------------
# OpenWeatherMap — Qualidade do Ar
# Obtenha em: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# NASA FIRMS — Focos de calor globais
# Obtenha em: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_MAP_KEY=
