# ============================================================
# AtmosMetrics — Backend .dockerignore
# ============================================================
# Exclui do build context tudo que não é necessário na imagem.
# Reduz tamanho do context e acelera o build.
# ============================================================

# --- Controle de versão ---
.git
.gitignore

# --- Python cache e bytecode ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.egg

# --- Ambientes virtuais ---
.venv/
venv/
env/
ENV/

# --- Testes (não vão para produção) ---
tests/
pytest.ini
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# --- IDE e editores ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Documentação ---
*.md
LICENSE

# --- Docker (evita recursão) ---
Dockerfile*
docker-compose*
.dockerignore

# --- Variáveis de ambiente ---
.env
.env.*

# --- Scripts SQL de manutenção ---
scripts/

# --- Logs ---
*.log
logs/

# --- OS ---
.DS_Store
Thumbs.db
